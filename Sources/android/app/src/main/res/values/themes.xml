<resources>
    <!-- Platform Material theme: no AndroidX/AppCompat dependency needed. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:buttonStyle">@style/Button</item>
    </style>

    <!-- Every button: normal capitalisation instead of ALL CAPS. -->
    <style name="Button" parent="@android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- The main action of a screen: filled with the app colour. -->
    <style name="Button.Primary" parent="@android:style/Widget.Material.Button.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">60dp</item>
    </style>

    <!-- A rounded white panel that groups related controls. -->
    <style name="Card">
        <item name="android:background">@drawable/card</item>
        <item name="android:padding">14dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="Hint">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>
</resources>
